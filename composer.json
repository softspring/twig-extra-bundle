{
    "name": "softspring/twig-extra-bundle",
    "description": "This bundle provides extra twig functions.",
    "type": "symfony-bundle",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "symfony/twig-bundle": "^6.4|^7.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.68",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.0",
        "symfony/config": "^6.4|^7.3",
        "symfony/dependency-injection": "^6.4|^7.3",
        "symfony/http-foundation": "^6.4|^7.3",
        "symfony/http-kernel": "^6.4|^7.3",
        "symfony/routing": "^6.4|^7.3",
        "symfony/twig-bridge": "^6.4|^7.3",
        "symfony/webpack-encore-bundle": "^2.1",
        "twig/twig": "^2.10|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\TwigExtraBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\TwigExtraBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
